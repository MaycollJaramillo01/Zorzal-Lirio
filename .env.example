NODE_ENV=development
PORT=3000

# Neon: cadena "pooled" (-pooler) para la app y "unpooled" para migraciones.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

APP_URL=http://localhost:3000
APP_TIMEZONE=America/Tegucigalpa

# Minimo 32 caracteres cada uno. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CRON_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Zorzal Lirio OS <notificaciones@example.com>"

EMAIL_ENABLED=false
SEED_DEFAULT_USERS=true
LOG_LEVEL=info

# HighLevel / WhatsApp. Nunca guardar el token real en Git.
GHL_WHATSAPP_ENABLED=false
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
